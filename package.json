{
  "name": "portal-especializacao",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:aluno": "npm run dev -w @portal/aluno",
    "dev:publico": "npm run dev -w @portal/publico",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:test": "npm run test:migrations -w @portal/db"
  },
  "engines": {
    "node": ">=20.9"
  }
}
