# Portal do Aluno — variáveis de ambiente.
# Copie para .env.local. Nenhum valor real neste arquivo.

# Supabase (a partir da Etapa 2). Sem elas, o portal funciona com dados fictícios
# e /api/saude informa "nao-configurado".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (só no servidor; nunca com prefixo NEXT_PUBLIC_). Usada apenas para enviar/gerar convites.
SUPABASE_SECRET_KEY=

# Segredo para /api/saude (≥ 16 caracteres). Gere com: openssl rand -hex 32
HEALTH_SECRET=

# Vídeos — Bunny Stream (Etapa 4 · Parte 2). SOMENTE no servidor; nunca com prefixo NEXT_PUBLIC_.
# Sem estas variáveis o portal funciona normalmente e o Admin mostra "Bunny ainda não configurado".
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
# Host das capas (Bunny → biblioteca → API → "CDN Hostname", ex.: vz-xxxx.b-cdn.net)
BUNNY_STREAM_CDN_HOST=
