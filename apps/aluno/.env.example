# Portal do Aluno — variáveis de ambiente.
# Copie para .env.local. Nenhum valor real neste arquivo.

# Supabase (a partir da Etapa 2). Sem elas, o portal funciona com dados fictícios
# e /api/saude informa "nao-configurado".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (só no servidor; nunca com prefixo NEXT_PUBLIC_). Usada apenas para enviar/gerar convites.
SUPABASE_SECRET_KEY=

# Segredo para /api/saude (≥ 16 caracteres). Gere com: openssl rand -hex 32
HEALTH_SECRET=
