# Fonte dos dados: "preview" (grade atual, sem deduções), "mock" (fictícios, testes) ou "sheets" (planilha real).
DATA_SOURCE=preview

# Google Sheets — só no servidor. Nunca use prefixo NEXT_PUBLIC_ nestas variáveis.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave privada da Service Account; quebras de linha podem vir como \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Segredo para POST /api/revalidar e GET /api/saude (gere com: openssl rand -hex 32)
REVALIDATE_SECRET=

# "noindex" (padrão) ou "index"
PORTAL_INDEXING=noindex
# URL pública do portal, ex.: https://portal.exemplo.com.br
PORTAL_BASE_URL=

# ── Área de edição (/coordenacao) ────────────────────────────────────────────
# Login com Google (OAuth "Aplicativo da Web"). URI de redirecionamento autorizado:
#   https://SEU-DOMINIO/api/auth/retorno
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Assina o cookie de sessão (mínimo 32 caracteres; gere com: openssl rand -hex 32)
SESSION_SECRET=
# E-mails da coordenação (separados por vírgula). Professores entram pela coluna "E-mail" da aba PROFESSORES.
ADMIN_EMAILS=
# SOMENTE para teste local sem Google (ignorado em produção e com DATA_SOURCE=sheets):
# AUTH_DEV_EMAIL=teste@exemplo.com
