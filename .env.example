# Fonte dos dados: "mock" (fixtures de desenvolvimento) ou "sheets" (planilha real).
DATA_SOURCE=mock

# Google Sheets — só no servidor. Nunca use prefixo NEXT_PUBLIC_ nestas variáveis.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave privada da Service Account; quebras de linha podem vir como \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Segredo para POST /api/revalidar e GET /api/saude (gere com: openssl rand -hex 32)
REVALIDATE_SECRET=

# "noindex" (padrão) ou "index"
PORTAL_INDEXING=noindex
# URL pública do portal, ex.: https://portal.exemplo.com.br
PORTAL_BASE_URL=
